# Copy to .env for local development. Never commit .env.
OIMS_ENV=development                 # development | production | testing
SECRET_KEY=change-me-to-64-random-characters
DATABASE_URL=postgresql://oims:password@localhost:5432/oims

# First-run Super Admin (choose ONE method, then remove these values)
#  a) Web setup page at /setup — requires this token:
OIMS_SETUP_TOKEN=
#  b) CLI: flask --app wsgi oims create-superadmin
OIMS_SUPERADMIN_EMAIL=
OIMS_SUPERADMIN_NAME=HOLIDO Super Admin
OIMS_SUPERADMIN_PASSWORD=

# Public URL used in emailed links
PUBLIC_BASE_URL=http://localhost:5000

# Outgoing email (optional; without it, set-password links are shown to the admin once)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=OIMS <no-reply@example.org>

# Security tuning
SESSION_COOKIE_SECURE=false          # true in production (HTTPS)
SESSION_HOURS=8
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12
RATELIMIT_STORAGE_URI=memory://      # use redis://... when running several instances
ALLOW_PUBLIC_REGISTRATION=true
